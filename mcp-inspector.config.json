{
  "mcpServers": {
    "bamboo-stdio": {
      "command": "npx",
      "args": ["tsx", "src/mcp/server.ts"],
      "env": {
        "NODE_ENV": "development"
      },
      "timeout": 30000
    },
    "bamboo-http": {
      "url": "http://localhost:3000/mcp",
      "env": {
        "NODE_ENV": "development"
      }
    }
  }
}
