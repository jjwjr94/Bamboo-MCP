# Environment Configuration for Bamboo MCP

# Server Configuration
PORT=8443
# NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/postgres

BASE_URL='https://bamboo-mcp-dev.onrender.com'

# =============================================================================
# JWT CONFIGURATION - EdDSA (Ed25519) KEYS
# =============================================================================
# CRITICAL: Generate Ed25519 key pairs using these commands:
#
# Generate private key:
# openssl genpkey -algorithm Ed25519 -out jwt_private.pem
#
# Extract public key:
# openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
#
# Then copy the entire PEM content including headers/footers

# Private key for signing JWTs (keep this secret!)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIExample_Private_Key_Content_Here_Replace_With_Actual
-----END PRIVATE KEY-----"

# Public key for verifying JWTs (can be shared)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAExample_Public_Key_Content_Here_Replace_With_Actual_Key
-----END PUBLIC KEY-----"

JWT_EXPIRES_IN=24h

# Facebook OAuth Configuration
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://localhost:8443/auth/facebook/callback

# Logging
LOG_LEVEL=info

