# Environment Configuration for Bamboo MCP

# Server Configuration
PORT=8443
# NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/postgres

BASE_URL='https://bamboo-mcp-dev.onrender.com'

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Facebook OAuth Configuration
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://localhost:8443/auth/facebook/callback

# Logging
LOG_LEVEL=info

