# Bamboo MCP Gateway (Fixed) - Environment Configuration

# Server Configuration
PORT=8443
NODE_ENV=development

# No complex authentication configuration needed!
# Just use your Meta access token directly in n8n

# Optional: Allowed origins for CORS (default: all origins allowed)
# ALLOWED_ORIGINS=https://app.n8n.cloud,https://your-n8n-instance.com

# Optional: Enable debug logging
# DEBUG=true

