{
  "name": "bamboo-mcp",
  "version": "0.1.0",
  "description": "Bamboo MCP - Model Context Protocol server for Meta Ads management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "prebuild:schemas": "tsx scripts/generateSchemas.ts",
    "prebuild": "npm run prebuild:schemas",
    "dev": "npm run prebuild && tsx watch src/index.ts",
    "build": "npm run prebuild && tsc && copyfiles -u 1 'src/**/*.md' dist && cp -r public dist/",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "checks": "biome check --write . && biome format --write . && tsc --noEmit",
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "mcp:server:stdio": "tsx src/mcp/server.ts",
    "mcp:inspect": "MCP_AUTO_OPEN_ENABLED=true npx @modelcontextprotocol/inspector",
    "mcp:inspect:stdio": "MCP_AUTO_OPEN_ENABLED=true npx @modelcontextprotocol/inspector --config mcp-inspector.config.json --server bamboo-stdio",
    "mcp:inspect:http": "MCP_AUTO_OPEN_ENABLED=true npx @modelcontextprotocol/inspector --config mcp-inspector.config.json --server bamboo-http"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/express": "^4.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "1.13.0",
    "@types/pg": "^8.15.4",
    "cockatiel": "^3.2.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "express": "^4.18.2",
    "facebook-nodejs-business-sdk": "22.0.3",
    "fastify": "^5.4.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-facebook-token": "^4.0.0",
    "fastify-type-provider-zod": "^5.0.1",
    "form-data": "^4.0.3",
    "jose": "^6.0.11",
    "p-timeout": "^6.1.4",
    "pg": "^8.16.2",
    "pkce-challenge": "^5.0.0",
    "postgres": "^3.4.7",
    "undici": "^7.10.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testcontainers/postgresql": "^11.0.3",
    "@types/express": "^4.17.21",
    "@types/facebook-nodejs-business-sdk": "22.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/passport": "^1.0.16",
    "@types/node": "^24.0.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "3.2.3",
    "@vitest/ui": "^3.2.3",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.1",
    "msw": "^2.10.2",
    "supertest": "^7.1.1",
    "testcontainers": "^11.0.3",
    "ts-json-schema-generator": "^2.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "meta-ads",
    "facebook-ads",
    "ai",
    "claude"
  ],
  "author": "Bamboo",
  "license": "Proprietary",
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
