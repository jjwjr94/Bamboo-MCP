{
  "name": "bamboo-mcp-fixed",
  "version": "0.3.0",
  "description": "Fixed MCP Gateway for Meta Ads with simplified authentication and HTTP Streamable transport",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:fixed": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:fixed": "nodemon --exec ts-node src/index.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"Linting not configured yet\"",
    "docker:build": "docker build -t bamboo-mcp-fixed .",
    "docker:run": "docker run -p 8443:8443 bamboo-mcp-fixed"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "meta-ads",
    "facebook-ads",
    "streamable-http",
    "ai",
    "claude",
    "n8n",
    "fixed"
  ],
  "author": {
    "name": "Jay Wong",
    "email": "jay@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjwjr94/Bamboo-MCP.git"
  },
  "homepage": "https://github.com/jjwjr94/Bamboo-MCP#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-facebook-token": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/passport": "^1.0.16",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.10.9",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}

